{
  "author": "Cyril Strone",
  "name": "@jenesei-software/jenesei-kit-react",
  "version": "1.3.30",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jenesei-software/jenesei-kit-react.git"
  },
  "license": "MIT",
  "type": "module",
  "files": [
    "build"
  ],
  "keywords": [
    "react",
    "ui",
    "tanstack",
    "framer-motion",
    "styled-components"
  ],
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.es.js",
      "require": "./build/index.cjs.js"
    },
    "./style-theme": {
      "types": "./build/style-theme.d.ts",
      "import": "./build/style-theme.es.js",
      "require": "./build/style-theme.cjs.js"
    }
  },
  "scripts": {
    "build:storybook": "cross-env NODE_ENV=storybook storybook build --quiet --disable-telemetry -o build",
    "build:library": "tsc && vite build",
    "build:main": "tsc && vite build",
    "storybook": "storybook dev -p 3030",
    "biome:lint": "biome lint .",
    "biome:format": "biome format --write src",
    "changelog": "conventional-changelog -p eslint -i CHANGELOG.md -s -r 0"
  },
  "peerDependencies": {
    "@jenesei-software/jenesei-ui-react": "^0.6.1",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0",
    "styled-components": ">=6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.1.1",
    "@jenesei-software/jenesei-plugin-vite": "^1.3.0",
    "@storybook/addon-docs": "^9.0.13",
    "@storybook/addon-links": "^9.0.13",
    "@storybook/react-vite": "^9.0.13",
    "@types/node": "^22.8.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/styled-components": "^5.1.34",
    "@vitejs/plugin-react": "^4.3.3",
    "cross-env": "^7.0.3",
    "fs": "^0.0.1-security",
    "globals": "^15.11.0",
    "path": "^0.12.7",
    "react-docgen-typescript": "^2.2.2",
    "rollup-plugin-visualizer": "^5.14.0",
    "sharp": "^0.33.5",
    "storybook": "^9.0.13",
    "terser": "^5.38.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-bundle-analyzer": "^0.0.1",
    "vite-plugin-dts": "^4.3.0",
    "vite-tsconfig-paths": "^5.0.1"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.13.0",
    "@tanstack/react-router": ">=1.97.0",
    "@tanstack/react-virtual": "^3.10.8",
    "framer-motion": "^11.13.1",
    "js-cookie": "^3.0.5",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "moment": ">=2.30.1",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0",
    "react-easy-crop": "^5.4.2",
    "react-image-webp": "^0.8.0",
    "react-leaflet": "^5.0.0",
    "react-leaflet-markercluster": "^5.0.0-rc.0",
    "react-number-format": "^5.4.2",
    "styled-components": ">=6.0",
    "styled-reset": "^4.5.2",
    "uuid": "^11.0.3"
  }
}
